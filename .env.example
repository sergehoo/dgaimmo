# ⚠️  Générer un VRAI secret avant déploiement :
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=__REPLACE_ME__generate_with_secrets_token_urlsafe_64_min_50_chars__REPLACE_ME__
DJANGO_ENV=prod
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=mutuellex.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://mutuellex.example.com
CORS_ALLOWED_ORIGINS=https://mutuellex.example.com
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1
USE_X_FORWARDED_HOST=1
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
APP_DOMAIN=mutuellex.example.com
LETSENCRYPT_EMAIL=admin@example.com
POSTGRES_DB=mutuellex
POSTGRES_USER=mutuellex
POSTGRES_PASSWORD=__REPLACE_ME__strong_random_password__
REDIS_PASSWORD=__REPLACE_ME__strong_random_password__
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
ENABLE_GIS=1
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
AI_DEFAULT_PROVIDER=ollama
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
