# =====================================================================
# .env.local.example — Overrides locaux MutuelleX
# =====================================================================
# Copier en `.env.local` (ignoré par git) et ajuster pour votre machine.
# Ce fichier est chargé APRÈS .env avec override=True : ses valeurs
# prennent le dessus sur .env (qui est généralement calibré pour Docker).
#
#   cp .env.local.example .env.local
#
# Cas d'usage : exécuter `python manage.py runserver` sur votre Mac
# alors que .env contient les hostnames Docker (mutuellex-postgres,
# mutuellex-redis...) qui ne sont pas résolvables hors du réseau Docker.
# ---------------------------------------------------------------------

# --- Environnement ---
DJANGO_ENV=dev
DJANGO_DEBUG=1

# --- Base de données locale ---
# Si PostgreSQL tourne nativement sur votre Mac :
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mutuellex
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ou pour ignorer PostgreSQL et utiliser SQLite (rapide, zéro install) :
# USE_SQLITE=1

# --- GIS (PostGIS) ---
# Mettre à 0 si GDAL/GEOS ne sont pas installés localement :
# ENABLE_GIS=0
# POSTGRES_ENGINE=django.db.backends.postgresql
#
# Ou laissez à 1 et installez : brew install gdal geos postgis
# ENABLE_GIS=1

# --- Redis local ---
# Si Redis tourne localement (brew services start redis) :
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Sécurité dev ---
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Désactiver HTTPS en dev local
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_HSTS_SECONDS=0
USE_X_FORWARDED_HOST=0
